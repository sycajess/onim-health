# Supabase → Project Settings → API

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Optional — Vercel sets VERCEL_URL automatically for OAuth redirects
VITE_APP_URL=https://your-app.vercel.app

# Google Calendar / Meet — OAuth 2.0 Web client
# Add redirect URI in Google Cloud: https://your-app.vercel.app/api/google/callback
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Serverless /api routes (Vercel env + local `npx vercel dev`)
# Required — exact names; use service_role, NOT anon key:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# npm run setup:supabase
SUPABASE_DB_PASSWORD=your-database-password
